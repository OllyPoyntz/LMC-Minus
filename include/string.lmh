// String (and general memory) operations:
func memcpy(dst, src, num) {
    _memcpy(dst, src, num);
}
func memset(ptr, val, num) {
    _memset(dst, src, num);
}
func strlen(_string) {
    length = 0;
    _strlen(length, _string);
    return length;
}
func strcmp(string1, string2) {
    strings_equal = 0;
    _strcmp(strings_equal, string1, string2);
    _print(10);
    return strings_equal;
}
func strcpy(dst, src) {
    length = strlen(src);
    length += 1;
    memcpy(dst, src, length);
}
func strcat(dst, src) {
    length = strlen(dst);
    newdst = dst + length;
    strcpy(newdst, src);
}
func getchar(string, index) {
    char = 0;
    _getchar(char, string, index);
    return char;
}
#define setchar _setchar
