// Functions relating to input and output.

// Printing a character is small enough to be inline:
#define printc _printc

// Outputs a string:
func prints(string) {
    _prints(string);
}
// Ensure that C-style functions can be used:
#define puts prints
#define putchar _printc
// Take user input, similar to Python's input function:
func input() {
    a = 0;
    prompt();
    _input(a);
    return a;
}

func inputs(buffer) {
	prompt();
	strlength = 0;
	_inputs(strlength, buffer);
	return strlength;
}
// C-style writing to stdout:
func write(string, chars) {
    _write(string, chars);
}

// Outputs a boolean value:
func printb(bool) {
    outstr = "false\0true";
    if (bool) {
        outstr += 6;
    }
    prints(outstr);
    flush();
}

// printf equivalent (unfortunately variadic args are not supported).
// By far the longest function in pure assembly - over 70 lines!
func printf(format, args) {
	_printf(format, args);
}

// Stack based printf:
func stackprintf(format) {
	_stackprintf(format);
}