// Functions relating to input and output.
#define printc _printc
// Outputs a string:
func prints(string) {
    _prints(string);
}
// Ensure that C-style functions can be used:
#define puts prints
#define putchar _printc
// Take user input, similar to Python's input function:
func input() {
    a = 0;
    prompt();
    _input(a);
    return a;
}
// C-style writing to stdout:
func write(string, chars) {
    _write(string, chars);
}
// Outputs a boolean value:
func printb(bool) {
    outstr = "false\0true";
    if (bool) {
        outstr += 6;
    }
    prints(outstr);
    flush();
}
