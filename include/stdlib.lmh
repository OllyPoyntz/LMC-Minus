// Standard library functions (mostly wrappers)
#include <string.lmh>
#include <stdio.lmh>
#include <stack.lmh>
// Converts a string to an integer:
func atoi(string) {
    num = 0;
    _atoi(num, string);
    return num;
}
// Converts an integer to a string, storing it in a buffer:
func itoa(num, buffer) {
    digits = 0;
    if (num == 0) {
	digits = 1;
    }
    num2 = num;
    while (num2 > 0) {
        digits += 1;
        num2 /= 10;
    }
    num2 = num;
    i = 0;
    while (i < digits) {
        i += 1;
        digit = '0' + (num2 % 10);
        targetpos = digits - i;
        buffer[targetpos] = digit;
        num2 /= 10;
    }
    buffer[digits] = 0;
    return buffer;
}
// Performs a bubble sort on an array. Requires O(n^2) time.
// (Bubble sort is by far the easiest sorting algorithm to implement, especially in assembly)
func bsort(arr, length) {
    _bsort(arr, length);
}
// Most efficient sorting algorithm in the library:
#define sort bsort

// Error handling:
func throw(msg) {
	prints(msg);
	exit(1);
}

func assert(val) {
	if (val == 0) {
		throw("AssertionError\n");
	}
}