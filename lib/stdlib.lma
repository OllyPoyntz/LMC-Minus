// Miscellaneous functions that don't really fit in any category:

// Exits the process, returning the given error code:
asm exit(code) {
    LDA code;
    HLT;
}

// Dynamically allocates memory on the stack:
asm _malloc(reg, amount) {
    loadop LDA __stack_pos;
    ADD loadop;
    SUB __base_load;
    SUB __ram_size;
    BRP reset;
    BRA continue;
    // If we run out of free space on the stack, loop back to the start:
    reset     LDA 1;
              STA __stack_pos;
            LDA loadop;
            ADD 1;
            BRA output;

    continue ADD __ram_size;
    output    STA reg;
    LDA __stack_pos;
    ADD amount;
    STA __stack_pos;
}

// Resets the stack:
asm _reset_stack() {
    LDA 1;
    STA __stack_pos;
}

// Frees allocated memory by moving the stack position back:
asm _free(amount) {
    LDA __stack_pos;
    SUB amount;
    BRZ panic;
    BRA return;
    panic LDA 0;
          HLT;
    return STA __stack_pos;
}

// Converts a string into an integer:
asm _atoi(reg, string) {
    LDA string;
    ADD __base_load;
    STA loadop;
    LDA 0;
    STA outnum;
    
    loadop  LDA string;
            STA num;
            BRZ return;
            SUB 48;
            BRP chkint;
            BRA return;
    chkint     SUB 10;
            BRP return;
            BRA isdigit;
    isdigit    LDA num;
            SUB 48;
            STA num;
            LDA outnum;
            // Yes, this is more efficient than using a loop:
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD outnum;
            ADD num;
            STA outnum;
            
            LDA loadop;
            ADD 1;
            STA loadop;
            BRA loadop;
    outnum     DAT 0;
    num     DAT 0;
    count     DAT 9;
    return     LDA outnum;
            STA reg;
}

// Sorts an array using bubble sort (swapping out-of-place pairs until the list is sorted):
asm _bsort(arr, length) {
    LDA 1;
    STA change;
    LDA length;
    STA plength;
    LDA arr;
    ADD __base_store;
    STA cache_storeop;
    LDA arr;
    ADD __base_load;
    STA cache_loadop;
    pass    LDA change;
            BRZ return;
            LDA cache_loadop;
            STA loadop;
            ADD 1;
            STA loadop2;
            LDA 0;
            STA pos;
            STA change;
            LDA plength;
            SUB 1;
            STA plength;
    loadop  LDA arr;
            STA num1;
    loadop2 LDA arr;
            STA num2;
    compare SUB num1;
            BRP next;
    swap    LDA cache_storeop;
            ADD pos;
            STA storeop1;
            ADD 1;
            STA storeop2;
            LDA num2;
            storeop1 STA arr;
            LDA num1;
            storeop2 STA arr;
            LDA 1;
            STA change;
    next    LDA plength;
            SUB pos;
            SUB 2;
            BRP next2;
            BRA pass;
    next2   LDA pos;
            ADD 1;
            STA pos;
            ADD cache_loadop;
            STA loadop;
            ADD 1;
            STA loadop2;
            BRA loadop;
    num1 DAT 0;
    num2 DAT 0;
    change DAT 0;
    plength DAT 0;
    pos DAT 0;
    cache_storeop STA arr;
    cache_loadop LDA arr;
    return LDA 0;
}

// Setting the errno through a function:
asm _set_errno(val) {
    LDA val;
    STA __errno;
}        
